<!DOCTYPE html>
<html lang="zh-Hant">
<head>
<meta charset="UTF-8" />
<title>座標點連線與Popup示範</title>
<style>
  #map {
    width: 800px;
    height: 600px;
    border: 1px solid #666;
    position: relative;
  }
  svg {
    width: 100%;
    height: 100%;
  }
  circle {
    fill: red;
    stroke: black;
    stroke-width: 1px;
    cursor: pointer;
  }
  line {
    stroke: blue;
    stroke-width: 2px;
  }
  .popup {
    position: absolute;
    background: white;
    border: 1px solid black;
    padding: 4px 8px;
    border-radius: 4px;
    pointer-events: none;
    font-family: sans-serif;
    font-size: 14px;
    white-space: nowrap;
    box-shadow: 2px 2px 5px rgba(0,0,0,0.3);
  }
</style>
</head>
<body>
<h3>座標點連線與Popup示範</h3>
<div id="map">
  <svg id="svg"></svg>
</div>
<div id="popup" class="popup" style="display:none;"></div>

<script>
const jsonUrl = 'https://raw.githubusercontent.com/joyease/game/main/2503Japan.json';

function convertCoord(lon, lat, bbox, width, height) {
  let x = ((lon - bbox.minLon) / (bbox.maxLon - bbox.minLon)) * width;
  let y = height - ((lat - bbox.minLat) / (bbox.maxLat - bbox.minLat)) * height;
  return {x, y};
}

fetch(jsonUrl)
.then(response => response.json())
.then(data => {
  const svg = document.getElementById('svg');
  const width = svg.clientWidth;
  const height = svg.clientHeight;
  const popup = document.getElementById('popup');
  const mapDiv = document.getElementById('map');

  const lons = data.map(d => d.Longitude);
  const lats = data.map(d => d.Latitude);
  const bbox = {
    minLon: Math.min(...lons),
    maxLon: Math.max(...lons),
    minLat: Math.min(...lats),
    maxLat: Math.max(...lats)
  };

  let prevPoint = null;

  data.forEach((point, index) => {
    const {x, y} = convertCoord(point.Longitude, point.Latitude, bbox, width, height);

    const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
    circle.setAttribute('cx', x);
    circle.setAttribute('cy', y);
    circle.setAttribute('r', 6);
    circle.style.cursor = 'pointer';
    svg.appendChild(circle);

    if (prevPoint) {
      const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
      line.setAttribute('x1', prevPoint.x);
      line.setAttribute('y1', prevPoint.y);
      line.setAttribute('x2', x);
      line.setAttribute('y2', y);
      svg.appendChild(line);
    }
    prevPoint = {x, y};

    circle.addEventListener('click', (evt) => {
      // 計算popup位置（map Div中）
      const rect = mapDiv.getBoundingClientRect();
      const popupX = rect.left + x + 10;
      const popupY = rect.top + y - 10;

      popup.style.left = popupX + 'px';
      popup.style.top = popupY + 'px';
      popup.style.display = 'block';
      popup.textContent = `地點: ${point.Location}  日期: ${point.Date}`;
      evt.stopPropagation();
    });
  });

  // 點擊其他地方隱藏popup
  document.addEventListener('click', () => {
    popup.style.display = 'none';
  });
})
.catch(err => {
  console.error('載入JSON出錯:', err);
});
</script>
</body>
</html>

